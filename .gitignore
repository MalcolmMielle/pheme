# Python-generated files
__pycache__/
*.py[oc]
build/
/dist/
wheels/
*.egg-info

# Virtual environments
.venv
data/

# Environment files
.env

# React app (react-app/) — JS toolchain artifacts
react-app/node_modules/
# Ignore the built frontend, but keep the directory itself tracked (via the
# .gitkeep placeholder): hatchling prunes gitignored directories during file
# selection, and the wheel must bundle react-app/dist when it is built.
react-app/dist/*
!react-app/dist/.gitkeep
