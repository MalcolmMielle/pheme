# ── Server ──────────────────────────────────────────────────────────────
# Public URL of this server (used in all ActivityPub IDs)
BASE_URL=http://localhost:8000

# Bind address and port for uvicorn
HOST=127.0.0.1
PORT=8000

# Enable uvicorn auto-reload (set to false in production)
RELOAD=true

# Trust X-Forwarded-* headers from a reverse proxy on this machine
# (Caddy/nginx) so rate limiting sees real client IPs instead of 127.0.0.1.
# Set to true in production behind a proxy; leave false when the app is
# exposed directly.
PROXY_HEADERS=false

# Comma-separated IPs allowed to set X-Forwarded-For.
# Default 127.0.0.1 is correct when the proxy runs on the same machine.
# FORWARDED_ALLOW_IPS=127.0.0.1

# ── Database ────────────────────────────────────────────────────────────
# Path to the SQLite database file
DATABASE_PATH=data/reviews.db

# ── Security ────────────────────────────────────────────────────────────
# Secret key for session signing — REQUIRED in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Session cookie lifetime in seconds (default: 30 days = 2592000)
SESSION_MAX_AGE=2592000

# Minimum password length for new accounts (default: 8)
PASSWORD_MIN_LENGTH=8

# ── Registration ────────────────────────────────────────────────────────
# Registration policy:
#   open   — anyone can register at /register (default; fine for dev)
#   invite — /register requires a one-time invite code; admins create codes
#            via POST /api/admin/invites and share /register?code=... links
#   closed — no self-registration; admins create accounts via POST /api/admin/users
REGISTRATION_MODE=open

# ── Places ──────────────────────────────────────────────────────────────
# Precision of the "same place" coordinate bucket: decimal places of
# lat/lng (default: 4 ≈ 11 m per step). Drives place grouping on the map
# and the one-review-per-actor-per-place rule; the SPA reads it from
# /api/meta, so both sides must agree.
PLACE_DECIMALS=4
